# Optional overrides for the gunicorn launcher (gunicorn/gunicorn.py).
# Copy to gunicorn/.env only if you need to change the defaults.

# Address and port the WSGI server listens on
GUNICORN_BIND=0.0.0.0:8000

# Number of workers (omit to size it automatically from the CPU count)
GUNICORN_WORKERS=1

# Best performance workers https://stackoverflow.com/a/63427961
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# eliminate worker timeout
GUNICORN_TIMEOUT=0

# Set 'debug' and 'true' values to restart workers
# on code hot changes (only local)
GUNICORN_LOGLEVEL=info
GUNICORN_RELOAD=false

# aether-link — application configuration.
# Copy to app/.env and adjust to your environment:  cp app/.env.example app/.env

# --- App & runtime ---
DEFAULT_TENANT=gijon
DEFAULT_SCOPE=/
ENABLE_SWAGGER=true
LOG_LEVEL=INFO

# --- Server / workers (also used as the DB pool size) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_FORWARDED_ALLOW_IPS=*
GUNICORN_LOGLEVEL=info
GUNICORN_RELOAD=false
GUNICORN_TIMEOUT=0
GUNICORN_WORKERS=8
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# --- Timeseries backend ---
DATA_SOURCE_TYPE=timescale
PLATFORM_TS_DB_HOST=timescale.pid.gijon.example
PLATFORM_TS_DB_PORT=5432
PLATFORM_TS_DB_NAME=CHANGE_ME
PLATFORM_TS_DB_USER=CHANGE_ME
PLATFORM_TS_DB_PASS=CHANGE_ME

# --- Context broker (NGSI-LD) ---
CONTEXT_BROKER_TYPE=orionld
ORION_LD_SERVICE=https://orionld.pid.gijon.example
CONTEXT_URL=https://pid.gijon.example/context/context-ngsi.jsonld
PLATFORM_SUBSCRIPTION_CONSUMER=https://carrot.pid.gijon.example/orion-ld/subscription
PLATFORM_SUBSCRIPTION_URN=urn:ngsi-ld:Subscription:platform:main

# --- IoT Agent ---
IOTA_TYPE=iotajsonLd
IOTA_JSON_URL=https://iota-north.pid.gijon.example

# --- Queues consumer API ---
QUEUES_CONSUMER_API=https://carrot.pid.gijon.example

# =============================================================================
# REFERENCE — the other pluggable backends. Only ONE backend per family is
# active at a time; uncomment the block you need and comment out the one above.
# =============================================================================
#

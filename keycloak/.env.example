# ---------------------------------------------------------------------------
# Plantilla de entorno para desarrollo local.
#   cp .env.example .env   y edita los valores marcados con ⚠ antes de usarla.
#
# ⚠ TODAS las credenciales de este fichero son de DESARROLLO y son públicas
#   (están en el repositorio). NO despliegues con ellas: en cualquier entorno
#   real cambia la contraseña de la base de datos, la del administrador y los
#   dos secretos de cliente de más abajo.
# ---------------------------------------------------------------------------

# --- Keycloak ---
KC_METRICS_ENABLED=true
KC_HEALTH_ENABLED=true
KC_FEATURES=token-exchange
KC_LOG_LEVEL=warn,org.keycloak.events:info

# --- Base de datos (el compose levanta su propio postgres:16-alpine) ---
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=changeme-dev-only          # ⚠ credencial de desarrollo

# --- Administrador inicial (solo se usa en el primer arranque) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-dev-only  # ⚠ credencial de desarrollo
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-dev-only  # ⚠ credencial de desarrollo

# --- Red / proxy ---
KC_HTTP_ENABLED=true
KC_HOSTNAME=http://localhost:8080
KC_HOSTNAME_ADMIN=http://localhost:8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_BACKCHANNEL=false
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KC_PROXY_HEADERS=xforwarded
PROXY_ADDRESS_FORWARDING=true
KC_PROXY_ADDRESS_FORWARDING=true
JAVA_OPTS_APPEND="-Djava.net.preferIPv4Stack=true -Xmx1g"

# URL pública del backend. El tema de login la usa para pedir el logotipo por
# organización; el entrypoint aborta si no está definida.
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Secretos de cliente del realm — OBLIGATORIOS
#
# El realm exportado (realm.json) no contiene ningún secreto: lleva los
# marcadores __KC_LARAVEL_BACKEND_SECRET__ y __KC_REALM_MANAGEMENT_SECRET__,
# que el entrypoint sustituye con estas variables. Si falta cualquiera de las
# dos el contenedor se detiene sin arrancar.
#
# Genera uno distinto por instalación (y guárdalos en tu gestor de secretos):
#
#     openssl rand -base64 24
#
# El mismo valor de KC_LARAVEL_BACKEND_SECRET debe configurarse en el backend
# como secreto del cliente `laravel-backend`.
# ---------------------------------------------------------------------------
KC_LARAVEL_BACKEND_SECRET=changeme-dev-only   # ⚠ openssl rand -base64 24
KC_REALM_MANAGEMENT_SECRET=changeme-dev-only  # ⚠ openssl rand -base64 24

# ---------------------------------------------------------------------------
# URLs de retorno OAuth (callback) de los clientes de servicio
#
# El realm ya no trae el comodín "/*" en laravel-backend, laravel-backend-client,
# vue-frontend ni dlm-client: "/*" es relativo al origen de Keycloak, así que
# aceptaba una redirección a CUALQUIER ruta que sirva Keycloak.
#
# Si no se define, se usa KC_HOSTNAME, que es exactamente el redirect_uri que el
# backend envía al canjear el código (KEYCLOAK_REDIRECT_URI). Lista separada por
# comas cuando haga falta más de una. El contenedor no arranca si queda vacía.
# ---------------------------------------------------------------------------
# KC_APP_REDIRECT_URIS=https://kc.example.com,https://app.example.com/login
# KC_APP_WEB_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Servidor de correo del realm
#
# Este canal transporta el código del segundo factor y los enlaces de reinicio
# de contraseña. Si se define KC_SMTP_HOST, el arranque EXIGE usuario, contraseña
# y cifrado: sin KC_SMTP_USER/KC_SMTP_PASSWORD, o con STARTTLS y SSL a la vez en
# false, el contenedor se detiene.
#
# Si KC_SMTP_HOST no se define no se configura correo: el reinicio de contraseña
# y el segundo factor por correo NO funcionarán (válido solo en desarrollo).
# ---------------------------------------------------------------------------
# KC_SMTP_HOST=smtp.example.com
# KC_SMTP_PORT=587                 # 587 = submission + STARTTLS; 465 = TLS implícito
# KC_SMTP_USER=
# KC_SMTP_PASSWORD=
# KC_SMTP_STARTTLS=true            # false solo si KC_SMTP_SSL=true
# KC_SMTP_SSL=false                # true para TLS implícito (puerto 465)
# KC_SMTP_FROM=no-reply@example.com
# KC_SMTP_FROM_DISPLAY_NAME=PID Gijon

# --- Configuración del realm aplicada en el arranque ---
# Idioma por defecto de las vistas del tema: es | en | ca | el | pt
KC_DEFAULT_LOCALE=es
# Auto-registro de usuarios en el login
KC_REGISTRATION_ALLOWED=false
# Cliente público de la aplicación móvil
KC_MOBILE_CLIENT_ENABLED=false

# --- Marca (opcional) ---
# Colores corporativos del tema de login y de los correos.
# KC_BRAND_PRIMARY=#7D00F4
# KC_BRAND_SECONDARY=#5800C0
# KC_BRAND_INDIGO=#150D5F
# Imagen del login: URL absoluta, ruta absoluta o nombre de fichero dentro de
# pidtheme/login/resources/img/. Si no se define se usa logo.png.
# KC_BRAND_LOGIN_IMAGE=

# --- Solo para instalaciones detrás de un proxy TLS ---
# KC_PROXY=edge fuerza redirecciones https y rompería el http local.
# KC_PROXY=edge

# ---------------------------------------------------------------------------
# queues-consumer — copy to .env and fill in for your environment.
# Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Worker role ---------------------------------------------------------
# One image, many roles. Pick one of:
#   sync | alarms | data | crowd | data_cache |
#   core | universal | universal_on_premise | custom |
#   cb_processor | generic_processor | dlq_recovery
WORKER_TYPE=universal
QUEUE_CONSUMER_WORKERS=1
WORKER_CONCURRENCY=8
UVICORN_WORKERS=1
LAUNCH_UVICORN=true
LAUNCH_CELERY_SCHEDULER=true
ENABLE_SWAGGER=false

# --- HTTP API access control (SEC-016/017/018/043) -----------------------
# REQUIRED. Shared secret for /publish and /stream, sent in the
# `X-Queues-Consumer-Token` header. Empty makes those endpoints answer 503,
# it does not make them public. Every caller needs the same value - notably
# the backend, which posts to QUEUES_CONSUMER_API_URL/publish.
QUEUES_CONSUMER_API_TOKEN=
# Comma-separated CORS allow list. Empty = no cross-origin browser access,
# which is the right default for a ClusterIP, server-to-server service. The
# previous `*` together with credentials was the combination the CORS spec
# forbids.
CORS_ALLOWED_ORIGINS=
# Comma-separated allow list of Celery task names /publish may dispatch.
# Empty uses PUBLISHABLE_TASKS_DEFAULT in app/api.py. /publish used to accept
# ANY registered task by name, Celery's own built-ins included.
PUBLISHABLE_TASKS=
# Root of the HLS output served by /stream. Referenced by app/api.py but
# never declared, so the endpoint raised AttributeError on every request.
STREAMING_OUTPUT_DIR=/code/app/tmp/streaming
IS_ON_PREMISE=false

# --- Main database (PostgreSQL) ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=platform
DB_USERNAME=
DB_PASSWORD=

# --- Realtime database (PostgreSQL) --------------------------------------
DB_REALTIME_HOST=postgres
DB_REALTIME_PORT=5432
DB_REALTIME_DATABASE=realtime
DB_REALTIME_USERNAME=
DB_REALTIME_PASSWORD=

# --- Timeseries (TimescaleDB) --------------------------------------------
# TIMESERIES_TYPE: timescale | none
TIMESERIES_TYPE=timescale
TS_DB_HOST=timescale
TS_DB_PORT=5432
TS_DB_DATABASE=platform_ts
TS_DB_USERNAME=
TS_DB_PASSWORD=
# Extra timeseries databases are read from TS_DB_1_*, TS_DB_2_*, … (contiguous)
TIMESERIES_REQUEST_TIMEOUT=300

# --- RabbitMQ ------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
# amqp (plain) | amqps (TLS)
RABBITMQ_SECURITY=amqp
# With amqps the broker certificate is verified and its name must match
# RABBITMQ_HOST. Path to the PEM of the CA that signed it; empty uses the system
# trust store, enough for a publicly signed broker. A missing path aborts startup.
RABBITMQ_CA_FILE_PATH=

# --- Object storage ------------------------------------------------------
# STORAGE_TYPE: s3 | local  (local = S3-compatible endpoint, e.g. MinIO)
STORAGE_TYPE=s3
FILES_PATH=temp_files
AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET=platform-storage
AWS_S3_ACCESS_ID=
AWS_S3_SECRET_KEY=
AWS_S3_IMAGES_REGION=eu-west-1
AWS_S3_IMAGES_BUCKET=platform-storage
AWS_S3_IMAGES_ACCESS_ID=
AWS_S3_IMAGES_SECRET_KEY=
# Only when STORAGE_TYPE=local
LOCAL_ENDPOINT=
LOCAL_BUCKET=
LOCAL_ACCESS_ID=
LOCAL_SECRET_KEY=
LOCAL_SECURE=false
LOCAL_IMAGES_ENDPOINT=
LOCAL_IMAGES_BUCKET=
LOCAL_IMAGES_ACCESS_ID=
LOCAL_IMAGES_SECRET_KEY=
LOCAL_IMAGES_SECURE=false

# --- Platform service URLs ------------------------------------------------
AETHER_LINK_URL=https://pid.gijon.example/aether-link
IOTA_URL=https://pid.gijon.example/iot-agent
TILEMAPPER_URL=
# Public front-end base URL, used to build the links inside notifications.
WEB_FRONT_URL=https://pid.gijon.example
DEFAULT_NOTIFICATION_FORMAT=ngsild
DEFAULT_EXTERNAL_REQUEST_TIMEOUT=5
DEFAULT_AETHER_LINK_REQUEST_TIMEOUT=10
OUT_CONNECTOR_REQUEST_TIMEOUT=5


# --- Keycloak -------------------------------------------------------------
KEYCLOAK_URL=https://pid.gijon.example/auth
KEYCLOAK_CLIENT_ID=queues-consumer-client
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=



# --- Mobile push notifications -------------------------------------------
# Base64 of the FCM service-account JSON; empty disables Android push.
FIREBASE_CREDENTIALS_BASE64=
# Base64 of the APNs .p8 key; empty disables iOS push.
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_ENVIRONMENT=sandbox

# --- Alarm notification channels -----------------------------------------
# Each channel stays off until its credentials are filled in: the alarm is still
# evaluated and recorded, only the notice is not sent (and it is logged).
# Telegram: the backend stores the chat_id when the account is linked.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# SMS via AWS SNS (the only supported provider).
SMS_ENABLED=false
SMS_PROVIDER=aws_sns
SMS_API_KEY=
SMS_API_SECRET=
SMS_AWS_REGION=eu-south-2
# Alphanumeric sender; empty uses whatever the carrier assigns.
SMS_FROM=
# WhatsApp via the Meta API (the only supported provider).
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email via SMTP. Without MAIL_HOST the channel is skipped with a logged warning.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address; empty falls back to MAIL_USERNAME.
MAIL_FROM=
# starttls (587) | ssl (465) | none
MAIL_ENCRYPTION=starttls
MAIL_TIMEOUT=10
# HTTP push: the destination URL is written by whoever configures the alarm, so
# only the destinations listed here are called. Comma-separated, each entry a
# host (subdomains included) or a URL prefix, e.g. "https://alerts.example.org/alarms"
# (matched by scheme, host, port and path segment, never as a string prefix).
# EMPTY SENDS NOTHING - that is the default on purpose. Destinations resolving to a private or loopback address
# are refused, and redirects are not followed.
HTTP_PUSH_ALLOWED_DESTINATIONS=
HTTP_PUSH_REQUEST_TIMEOUT=5
# The entity-command channel needs no credentials: it writes the command as a
# Command attribute through AETHER_LINK_URL.

# --- Periodic jobs --------------------------------------------------------
AUTO_SYNC_INTERVAL=604800
# How often inactivity alarms are swept. Keep it no larger than the shortest
# wait configured in any alarm.
INACTIVITY_ALARM_CHECK_INTERVAL=3600
DAYS_OF_GRACE=10
CROWD_PROCESS_VISITORS_INTERVAL=3600
CROWD_FLOWS_MUNICIPALITY_INTERVAL=3600
CROWD_CLASSIFICATION_INTERVAL=86400
DATA_CACHE_CROWD_PROCESS_INTERVAL=3600
DATA_CACHE_DELETE_AFTER_UPLOAD=false

# --- Device healthcheck ---------------------------------------------------
HEALTHCHECK_INTERVAL=3000
HEALTHCHECK_DEVICE_DATAMODEL=DeviceHealthcheck
HEALTHCHECK_TENANT=
HEALTHCHECK_SCOPE=/

# --- Per-queue tuning -----------------------------------------------------
# QUEUE_TASK_CONFIG_<QUEUE_NAME_UPPERCASED>_{PRIORITY,TIMEOUT,MAX_RETRIES,RETRY_BACKOFF}
# e.g. platform.sync.cb_notification -> QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_TIMEOUT
QUEUE_TASK_CONFIG_DEFAULT_PRIORITY=10
QUEUE_TASK_CONFIG_DEFAULT_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_PRIORITY=20
QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_TIMEOUT=10
QUEUE_TASK_CONFIG_PLATFORM_SYNC_REALTIME_PRIORITY=15
QUEUE_TASK_CONFIG_PLATFORM_SYNC_REALTIME_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_SYNC_TIMESERIES_PRIORITY=15
QUEUE_TASK_CONFIG_PLATFORM_SYNC_TIMESERIES_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_DATA_IMPORTATION_TIMEOUT=3600
# Alarms query the timeseries and send notices; the default 5 s is not enough.
QUEUE_TASK_CONFIG_PLATFORM_ALARMS_ENTITY_DATA_CHECK_TIMEOUT=60
QUEUE_TASK_CONFIG_PLATFORM_ALARMS_CHECK_INACTIVITY_TIMEOUT=600
NUM_MAX_RETRIES=5
CONNECTOR_DEACTIVATION_WINDOW_SECONDS=60

# --- Dead letter queue recovery ------------------------------------------
DLQ_MAX_LENGTH=150000
DLQ_RECOVERY_IDLE_TIMEOUT_SECONDS=30
DLQ_RECOVERY_CHECK_INTERVAL_SECONDS=10

# --- Observability --------------------------------------------------------
METRICS_PORT=8000
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACE_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# queues-consumer — copy to .env and fill in for your environment.
# Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Worker role ---------------------------------------------------------
# One image, many roles. Pick one of:
#   sync | data | crowd | data_cache |
#   core | universal | universal_on_premise | custom |
#   cb_processor | generic_processor | dlq_recovery
WORKER_TYPE=universal
QUEUE_CONSUMER_WORKERS=1
WORKER_CONCURRENCY=8
UVICORN_WORKERS=1
LAUNCH_UVICORN=true
LAUNCH_CELERY_SCHEDULER=true
ENABLE_SWAGGER=false
IS_ON_PREMISE=false

# --- Main database (PostgreSQL) ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=platform
DB_USERNAME=
DB_PASSWORD=

# --- Realtime database (PostgreSQL) --------------------------------------
DB_REALTIME_HOST=postgres
DB_REALTIME_PORT=5432
DB_REALTIME_DATABASE=realtime
DB_REALTIME_USERNAME=
DB_REALTIME_PASSWORD=

# --- Timeseries (TimescaleDB) --------------------------------------------
# TIMESERIES_TYPE: timescale | none
TIMESERIES_TYPE=timescale
TS_DB_HOST=timescale
TS_DB_PORT=5432
TS_DB_DATABASE=platform_ts
TS_DB_USERNAME=
TS_DB_PASSWORD=
# Extra timeseries databases are read from TS_DB_1_*, TS_DB_2_*, … (contiguous)
TIMESERIES_REQUEST_TIMEOUT=300

# --- RabbitMQ ------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
# amqp (plain) | amqps (TLS)
RABBITMQ_SECURITY=amqp

# --- Object storage ------------------------------------------------------
# STORAGE_TYPE: s3 | local  (local = S3-compatible endpoint, e.g. MinIO)
STORAGE_TYPE=s3
FILES_PATH=temp_files
AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET=platform-storage
AWS_S3_ACCESS_ID=
AWS_S3_SECRET_KEY=
AWS_S3_IMAGES_REGION=eu-west-1
AWS_S3_IMAGES_BUCKET=platform-storage
AWS_S3_IMAGES_ACCESS_ID=
AWS_S3_IMAGES_SECRET_KEY=
# Only when STORAGE_TYPE=local
LOCAL_ENDPOINT=
LOCAL_BUCKET=
LOCAL_ACCESS_ID=
LOCAL_SECRET_KEY=
LOCAL_SECURE=false
LOCAL_IMAGES_ENDPOINT=
LOCAL_IMAGES_BUCKET=
LOCAL_IMAGES_ACCESS_ID=
LOCAL_IMAGES_SECRET_KEY=
LOCAL_IMAGES_SECURE=false

# --- Platform service URLs ------------------------------------------------
AETHER_LINK_URL=https://pid.gijon.example/aether-link
IOTA_URL=https://pid.gijon.example/iot-agent
TILEMAPPER_URL=
# Public front-end base URL, used to build the links inside notifications.
WEB_FRONT_URL=https://pid.gijon.example
DEFAULT_NOTIFICATION_FORMAT=ngsild
DEFAULT_EXTERNAL_REQUEST_TIMEOUT=5
DEFAULT_AETHER_LINK_REQUEST_TIMEOUT=10
OUT_CONNECTOR_REQUEST_TIMEOUT=5


# --- Keycloak -------------------------------------------------------------
KEYCLOAK_URL=https://pid.gijon.example/auth
KEYCLOAK_CLIENT_ID=queues-consumer-client
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=



# --- Mobile push notifications -------------------------------------------
# Base64 of the FCM service-account JSON; empty disables Android push.
FIREBASE_CREDENTIALS_BASE64=
# Base64 of the APNs .p8 key; empty disables iOS push.
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_ENVIRONMENT=sandbox

# --- Periodic jobs --------------------------------------------------------
AUTO_SYNC_INTERVAL=604800
DAYS_OF_GRACE=10
CROWD_PROCESS_VISITORS_INTERVAL=3600
CROWD_FLOWS_MUNICIPALITY_INTERVAL=3600
CROWD_CLASSIFICATION_INTERVAL=86400
DATA_CACHE_CROWD_PROCESS_INTERVAL=3600
DATA_CACHE_DELETE_AFTER_UPLOAD=false

# --- Device healthcheck ---------------------------------------------------
HEALTHCHECK_INTERVAL=3000
HEALTHCHECK_DEVICE_DATAMODEL=DeviceHealthcheck
HEALTHCHECK_TENANT=
HEALTHCHECK_SCOPE=/

# --- Per-queue tuning -----------------------------------------------------
# QUEUE_TASK_CONFIG_<QUEUE_NAME_UPPERCASED>_{PRIORITY,TIMEOUT,MAX_RETRIES,RETRY_BACKOFF}
# e.g. platform.sync.cb_notification -> QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_TIMEOUT
QUEUE_TASK_CONFIG_DEFAULT_PRIORITY=10
QUEUE_TASK_CONFIG_DEFAULT_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_PRIORITY=20
QUEUE_TASK_CONFIG_PLATFORM_SYNC_CB_NOTIFICATION_TIMEOUT=10
QUEUE_TASK_CONFIG_PLATFORM_SYNC_REALTIME_PRIORITY=15
QUEUE_TASK_CONFIG_PLATFORM_SYNC_REALTIME_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_SYNC_TIMESERIES_PRIORITY=15
QUEUE_TASK_CONFIG_PLATFORM_SYNC_TIMESERIES_TIMEOUT=5
QUEUE_TASK_CONFIG_PLATFORM_DATA_IMPORTATION_TIMEOUT=3600
NUM_MAX_RETRIES=5
CONNECTOR_DEACTIVATION_WINDOW_SECONDS=60

# --- Dead letter queue recovery ------------------------------------------
DLQ_MAX_LENGTH=150000
DLQ_RECOVERY_IDLE_TIMEOUT_SECONDS=30
DLQ_RECOVERY_CHECK_INTERVAL_SECONDS=10

# --- Observability --------------------------------------------------------
METRICS_PORT=8000
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACE_SAMPLE_RATE=0

#########################################
# MONGO DATABASE
#########################################
MONGO_DB_HOST=
MONGO_DB_PORT=
MONGO_DB_DATABASE=
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

#########################################
# GENERAL
#########################################
IOTA_SOUTH_SERVICE=

# Seconds before an outbound HTTP call to the IoT Agent is given up on.
# Must not be left blank — it is parsed as an int.
HTTP_TIMEOUT=10
# CRITICAL | ERROR | WARNING | INFO | DEBUG. Blank means INFO; DEBUG also turns on
# urllib3/pymongo per-connection logging, which is very verbose.
LOG_LEVEL=

GUNICORN_WORKER_CLASS=
GUNICORN_BIND=
GUNICORN_KEEPALIVE=
# Seconds before gunicorn considers a worker hung and aborts it. Defaults to 120
# (gunicorn's own default of 30 is below our worst-case round trip).
GUNICORN_TIMEOUT=

#########################################
# HTTP API
#########################################
# Exposes /docs, /redoc and /openapi.json. Keep it false outside development.
ENABLE_SWAGGER=false

#########################################
# OTE (LIDAR) RAW ARCHIVE
#########################################
# Password expected in the ?t= query param or the X-OTE-Token header. Empty
# accepts everything: local/dev only, the endpoint is public.
# SEC-025. REQUIRED. Shared secret the LIDAR sensors must send in the
# `X-OTE-Token` header. Leaving it empty no longer means "accept everyone":
# the ingest endpoint now rejects every request until it is set. The token is
# NOT accepted in the query string any more (the old `?t=`), because a secret
# in a URL is copied into every access log along the path.
OTE_WEBHOOK_TOKEN=
OTE_ARCHIVE_ENABLED=false
# Staging: the ingest cron consolidates this into ote/raw/ and empties it.
OTE_ARCHIVE_PREFIX=ote/incoming
OTE_FLUSH_SECONDS=60
# 4 MB per device is the memory ceiling; 144 MB with 36 sensors.
OTE_FLUSH_MAX_BYTES=4194304
OTE_MAX_BUFFER_BYTES=209715200
# SEC-024. Ceiling on the OUTPUT of gunzipping a sensor body, enforced while
# inflating. The buffer caps above act on already-decompressed data, so they
# cannot stop a decompression bomb.
OTE_MAX_DECOMPRESSED_BYTES=67108864

# SEC-044. REQUIRED. Shared secret for the IoT Agent southbound command proxy
# (`X-IOTA-Proxy-Token` header). Those routes had no access control at all.
# Empty means the proxy refuses every request, not that it is open.

# Where the archive is written: "s3" (AWS S3) or "local" (MinIO / on-premise).
STORAGE_TYPE=
# STORAGE_TYPE=s3
AWS_S3_ACCESS_ID=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
# STORAGE_TYPE=local (Minio, on-premise). ENDPOINT is host:port, no scheme.
LOCAL_ACCESS_ID=
LOCAL_SECRET_KEY=
LOCAL_ENDPOINT=
LOCAL_BUCKET=
LOCAL_SECURE=false

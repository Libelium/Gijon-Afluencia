# Copy to .env and adjust. Never commit the real .env (it holds secrets).
# An EMPTY value means "not set": the default applies.
#
# Most are declared and typed in crowd_predictions/config/settings.py. Three groups
# are NOT: AWS_S3_* and LOCAL_* live in config/{s3,local}_storage_settings.py, and the
# IOTA_*/TEST_* block at the bottom is still read with plain os.environ.get() in
# crowd_predictions/fake_measures.py - it is the piece of the settings rework left
# undone.

# --- Sensor segregation (on-premise deployments without LIDAR) ---
ENABLE_SMARTSPOT=true
ENABLE_LIDAR=true

# --- Data source ---
# synthetic: fixtures.py (no real sensors) | real: BOTH sides from the platform -
# Smart Spot from CrowdFlowObserved (helpers/smartspot_history.py, collapsed with MAX
# over the hour so it covers the same window as the LIDAR peak) and LIDAR from
# CrowdFlowLidarZone (helpers/lidar_zone_history.py). Never half and half: that would
# fuse two unrelated worlds. See etl/crowd/extract.py.
# DEFAULT "real": omitting this variable must not publish made-up occupancy against a
# live tenant. "synthetic" logs a loud warning on every run.
DATA_SOURCE=real
SYNTHETIC_DAYS=5

# Only with DATA_SOURCE=real, LIDAR side: which entity/attribute helpers/
# lidar_zone_history.py reads from the platform (one CrowdFlowLidarZone entity per
# zone, published by an ETL outside this repo).
# PROVISIONAL, both: the datamodel doc marks these names as not fixed in the platform yet.
LIDAR_ZONE_ENTITY_TYPE=CrowdFlowLidarZone
# totalConcurrentMax, NEVER totalCount: aforo (simultaneous), not afluencia (cumulative).
LIDAR_ZONE_CONCURRENT_ATTR=totalConcurrentMax
# How old a LIDAR zone reading may be and still count as "this window". The broker
# serves the last value it was given for ever, so without this a stopped upstream ETL
# keeps the fusion publishing a frozen aforo as confidence="measured". A dropped
# reading makes its zone fall back to Smart Spot (or to no_data). 0 disables the check.
# CAREFUL going below 120: that ETL is hourly and stamps each sample with the START of
# its window, so the freshest reading there is is already up to an hour old by
# observedAt. 60 here would drop every single one and blank the LIDAR side.
LIDAR_ZONE_MAX_AGE_MINUTES=180

# Zones to read CrowdFlowZone history for (training/prediction). Empty = autodiscovery
# in the broker, same convention as DEVICE_IDS below.
ZONE_IDS=

# --- Anomaly detection (crowd_predictions/anomaly_detection/) ---
# A SEPARATE VERTICAL: it is not wired into the fusion, prediction or ingestion ETLs
# and adds no column to what those publish. It knows nothing about zones or occupancy
# - only entity ids, measures and timestamps - so it can be pointed at any datamodel.
#
# One entry per datamodel. Required: `measures` (a LIST) and `cadence_minutes` (how
# often it reports - every "how many points" knob is declared as a duration and
# converted through it). Optional:
#   calendar        which cycles the signal actually has: "hour", "weekday", "month".
#                   DEFAULT EMPTY, and worth thinking about: with no calendar the
#                   model cannot tell 50 people at 04:00 from 50 at 13:00, and on a
#                   stationary signal it collapses to a single centroid (measured).
#                   A cycle the signal does NOT have is just noise diluting it.
#   decay_days      how far back the statistics still matter (default 30).
#   rolling_hours   span of the recent-volatility window (default 5).
#   regime_shift_hours  how long a sustained shift takes to become the new normal.
#   min_measure_coverage  fraction of rows a column must appear in to count as a
#                   measure when they are auto-detected (default 0.9). Lower it
#                   for a platform that reports attributes at uneven cadences.
#
#   ANOMALY_CONFIG={"Example": {"measures": ["measure1", "measure2"], "cadence_minutes": 60, "calendar": ["hour", "weekday"]}}
ANOMALY_CONFIG=
# Root of the whole vertical in storage, segregated by tenant/scope inside:
#   <prefix>/{tenant}/{scope}/*.csv        dropped here to be scored
#   <prefix>/{tenant}/{scope}/models/      one bundle per datamodel
#   <prefix>/{tenant}/{scope}/processed/   the same rows + isOutlier
ANOMALY_PREFIX=anomalies_detection
# SEC-019. REQUIRED to persist or reload an anomaly bundle. Any long random
# string, identical on every replica of a deployment. The bundle is a pickle,
# so it is authenticated with HMAC-SHA256 before being deserialised: without a
# key nothing is loaded (the datamodel simply retrains), and a bundle this
# deployment did not write is refused. Rotating the key retrains every
# datamodel - which is also the recovery step if a bundle is ever suspect.
ANOMALY_STATE_HMAC_KEY=

# --- Storage (output CSVs and trained model) ---
# s3    -> real AWS. DEFAULT. A local run also writes to the environment's S3, so
#          the real flow gets exercised from your machine.
# local -> Minio, on-premise without AWS. The on-prem manifests already inject it.
STORAGE_TYPE=s3

# S3 credentials.
AWS_S3_ACCESS_ID=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=eu-south-2
AWS_S3_BUCKET=

# Only with STORAGE_TYPE=local. Empty on an AWS deployment.
LOCAL_ACCESS_ID=
LOCAL_SECRET_KEY=
# CAREFUL: host:port, NO scheme ("http://" is rejected); TLS is LOCAL_SECURE.
# On on-premise k8s: minio.minio.svc.cluster.local:9000
LOCAL_ENDPOINT=
LOCAL_BUCKET=
LOCAL_SECURE=false

# --- Publishing to the platform (S3 -> queue, see helpers/uploader.py) ---
QUEUES_CONSUMER_API_URL=
# Assign the user_id of the integrations service account. NO default and nothing is
# published without it: the consumer tracks the job AND sends that user a
# notification PER published CSV (one per zone, or one per sensor), so a real person's
# account gets flooded with cron noise. It grants no access - the tenant travels
# separately in the message and nothing cross-checks the two.
QUEUES_CONSUMER_USER_ID=
# Tenant of the deployment (FIWARE_TARGETS overrides it). CAREFUL: this pair feeds the queue message, the model key AND the
# Aether queries - a separate AETHER_* pair could read one scope and write another.
FIWARE_TENANT=
# Every scope on the platform is "/"; the real filtering is by tenant.
FIWARE_SCOPE=/

# SEVERAL TENANTS IN ONE RUN: "tenant:scope" pairs, one full cycle each; empty = the
# single pair above. The pair goes TOGETHER per element: crossing a tenant with
# another's scope is NOT reported (HTTP 200, empty). Tuning is paid PER TARGET.
#   FIWARE_TARGETS=tenant_a:/,tenant_b:/
#
# A THIRD, OPTIONAL FIELD lists the LIDAR devices of that target, "|" separated. It is
# needed because the raw LIDAR feed carries NO tenant - fiware-manager only knows the
# device id of the URL - so without it every target would publish every device's data.
# Absent = every device (the only sane default with one tenant).
#   FIWARE_TARGETS=tenant_a:/:L1|L2|L3,tenant_b:/:L4
FIWARE_TARGETS=

# --- Aether Link connection (the platform link itself) ---
# No default on purpose: the code must not know which environment it points at.
# e.g. https://<aether-link-host>, per environment.
AETHER_LINK_URL=
# Context Broker calls only. The time-series one is a fixed 300 s in helpers/
# aether.py: a year over several sensors is slow, not hung.
AETHER_REQUEST_TIMEOUT=10
# Measurements per time-series request. 200000 covers a hourly year of a dozen
# sensors (365*24*10 = 87600).
AETHER_TIMESERIES_LIMIT=200000
# NGSI-LD type of the Smart Spot sensors themselves - NOT what training/prediction
# read any more (that is CrowdFlowZone, see ZONE_IDS/CROWD_FLOW_ZONE_ENTITY_TYPE below).
# Still the publish-side default entity type (helpers/uploader.py,
# smartspot_transform.py) and what resolve_device_ids() autodiscovers, a still-valid
# generic utility no current pipeline calls by default.
ENTITY_TYPE=CrowdFlowObserved
# Only relevant together with the two above (resolve_device_ids()/load_history_bins()
# called explicitly with Smart-Spot ids/measure - not the live training/prediction path).
CROWD_MEASURE_ID=peopleCountMediumInterval
# Comma-separated. EMPTY = autodiscovery in the broker, skipping the "_pred"
# entities (our own output; feeding them back trains the model on its predictions).
#   DEVICE_IDS=urn:ngsi-ld:CrowdFlowObserved:Device_1,urn:ngsi-ld:CrowdFlowObserved:Device_2
DEVICE_IDS=
# Read window of PREDICTION only, despite the name - the warm start passes its own
# window and never reads this. THE EASIEST TRAP: under 7 days lag_1w is NaN everywhere
# and nothing publishes; 7 to 28 drops rolling_*_28d.
# Empty = the floor, 28 + TRAINING_HOLDOUT_DAYS + 7 = 1176 h; less is raised to it.
INCREMENTAL_HOURS=
# Fraction of a rolling window's days that must exist for it to give a value
# instead of NaN. A fraction and not "all" because the gaps are legitimate: bins
# only exist where the sensor reported. Empty = 0.75.
ROLLING_MIN_COVERAGE=

# --- ETL output (before uploading) ---
PREDICTIONS_OUTPUT_DIR=predictions_per_zone
# Entity type of the zone aggregate. Dual role: the fusion ETL PUBLISHES it, and
# training/prediction READ it back as their live history source (see ZONE_IDS
# above) - keep it as one setting, not two that have to be kept in sync by hand.
CROWD_FLOW_ZONE_ENTITY_TYPE=CrowdFlowZone

# --- LIDAR raw ingestion (scripts/run_ote.py = compaction + ingestion; the two
#     halves on their own are scripts/compact_ote_archive.py and run_ingest.py) ---
# Staging area where fiware-manager dumps the raw feed, emptied on every run:
#   <prefix>/<device_id>/YYYY/MM/DD/<ms>-<pid>-<seq>.ndjson.gz
OTE_INCOMING_PREFIX=ote/incoming
# The archive proper, WRITTEN by the compaction and READ by the ETL:
#   <prefix>/<device_id>/YYYY/MM/DD/YYYYMMDD-HHMM-HHMM.ndjson.gz
OTE_RAW_PREFIX=ote/raw
# Concurrent downloads per device while compacting. The work waits on the network, not
# on cores; botocore's connection pool (10 by default) is the real ceiling above this.
OTE_DOWNLOAD_WORKERS=8
# Where this deployment's zones.json lives (see zones_config.py). Under ote/ because
# the zones ARE the LIDAR installation; segregated by tenant/scope inside. NO FILE =
# the crowd ETLs refuse to start, on purpose.
OTE_ZONES_PREFIX=ote/zones
# Aggregation window, and the cadence of the CronJob.
OTE_WINDOW_SECONDS=3600
# The manifests get a prefix of their own, not a slot beside the archived object:
# recover() lists every manifest on every run, and next to the data that means walking
# the whole history to find a handful.
OTE_MANIFEST_PREFIX=ote/manifests
# The file name is the START of the dump window, so a file named before the window
# still holds events inside it. Without this margin the first minutes of every run are
# lost and nothing fails.
OTE_READ_MARGIN_SECONDS=3600
# Days before the window whose directories are listed: an archived object is filed
# under the day it STARTED, which can be earlier than the window it still contains.
OTE_ARCHIVE_LOOKBACK_DAYS=1
# Silence that closes a presence segment. Decides permanence AND transits.
OTE_TRACK_GAP_SECONDS=30
# Threshold of totalStationaryCount. It COUNTS, it does not filter.
OTE_STATIONARY_MAX_DISPLACEMENT_M=1.0
# Closed list of labels.type with a series of their own, HIGHEST PRIORITY FIRST: when a
# track is seen as more than one of these in the same report window, whichever is listed
# earliest wins (vehicle outranks adult - a LIDAR only ever misreads a car as something
# smaller by occlusion, never the other way round). Comma separated.
OTE_LABEL_ATTRS=vehicle,adult
# Empty = discover the device ids by listing OTE_RAW_PREFIX.
OTE_DEVICE_IDS=
OTE_OUTPUT_DIR=ote_ingest
# PROVISIONAL, both: there is no LIDAR datamodel registered in the platform yet and the apikey
# is resolved by datamodel. Renaming them renames the entities already created.
OTE_ZONE_ENTITY_TYPE=CrowdFlowLidarZone
OTE_DEVICE_ENTITY_TYPE=CrowdFlowLidarDevice
# The crowd metrics PER SENSOR, apart from the device's health: two different
# questions ("is it alive" vs "how many people did it see"), and the zone aggregate
# hides which of its sensors carries the traffic. Provisional too.
OTE_OBSERVED_ENTITY_TYPE=CrowdFlowLidarObserved

# --- Calendar features (per deployment) ---
# The bins are stored in UTC, but hour/weekday/holiday are LOCAL-calendar concepts:
# at UTC+2 a Sunday 00:30 local is a Saturday 22:30 UTC, and taken raw it lands on
# the wrong DAY - which is where the nightlife volume is. Used ONLY to derive the
# calendar features: storage and published timestamps stay UTC. Handles DST by
# itself. Changing it forces a full retrain (the columns do not change, their
# MEANING does). "UTC" reproduces the behaviour from before this existed.
# No default on purpose: every hour belongs to some timezone, so inheriting one
# shifts every calendar feature in silence. Mandatory, IANA name.
CALENDAR_TIMEZONE=
# With the wrong region is_holiday does NOT fail, it marks the wrong days and the
# model learns that people go out on a Tuesday that was never a holiday there.
# HOLIDAYS_COUNTRY is mandatory (ISO code). HOLIDAYS_SUBDIVISION empty or "none" ->
# national holidays only: less precise, but it never marks the wrong days.
HOLIDAYS_COUNTRY=
HOLIDAYS_SUBDIVISION=
# "MM-DD..MM-DD" pairs; a range may cross the year end. Per deployment: a ski resort's
# high season is the opposite of a beach one. Empty -> no high season at all.
HIGH_SEASON_RANGES=
# Weight per event type for the event_magnitude feature, as JSON. Merged over the
# built-in {"small_event": 1, "large_event": 2}; empty keeps just those. Re-weighing a
# type forces a full retrain by itself (the fingerprint hashes the magnitude).
EVENT_MAGNITUDES=

# --- Weather (rain reduces outdoor crowd counts, see weather.py) ---
# No default, unlike the rest of this file - there is no reasonable latitude/
# longitude to fall back to. Empty is safe though: with neither set, the refresh
# in daily_pipeline.py is a no-op and precip_mm stays 0.0 everywhere (never
# blocks training/prediction) instead of failing at startup.
WEATHER_LAT=
WEATHER_LON=
WEATHER_CACHE_PREFIX=weather-cache
# Multi-tenant only: "tenant:lat:lon,tenant2:lat2:lon2" - every tenant is a
# different city, so WEATHER_LAT/LON alone would apply one city's rain to all of
# them. Empty (the default) -> WEATHER_LAT/LON above, unchanged single-tenant
# behaviour. See weather.py::coordinates_for_current_tenant.
WEATHER_TARGETS=

# --- Manual events (markets, fairs, concerts - see events_registry.py) ---
# No prefix of its own - uploaded/edited by hand under the SAME MODELS_PREFIX
# route as the model. Nothing to configure here.

# --- Training (scripts/train.py) ---
# History read LIVE from the platform, per zone (CrowdFlowZone): nothing to mount in
# a CronJob and no export left to age. See ZONE_IDS above for which zones.
#
MODEL_OUTPUT_PATH=crowd_xgboost_model.json
MODELS_PREFIX=prediction-models
# Days held out to measure a COLD start. Trimmed to a third of the usable history
# when it does not fit, or a short history would leave the training set empty.
TRAINING_HOLDOUT_DAYS=14
# Rounds without improvement before xgboost stops adding trees. The validation slice
# is carved out of the TRAIN side, never out of the holdout - choosing the tree count
# on the holdout would make the reported MAE optimistic. 0 disables it.
EARLY_STOPPING_ROUNDS=50
# Hours of recursive backtest after a FULL retrain, to get a MAE per horizon step.
# evaluate_model() only measures one step, so without this the horizonStep we publish
# is a qualitative warning with no number behind it. Costs one feature-table rebuild
# per step; 0 disables it.
BACKTEST_HORIZON_HOURS=24

# --- Incremental retraining / warm start ---
# The mode is NOT configured: a model in storage (with its two sidecars) means warm
# start, no model means cold with tuning. These five only tune the warm start.
# New trees per run, over the saved booster (parking uses 50).
N_ESTIMATORS_INCREMENT=50
# Age of the last FULL retrain past which the next run does one. This is what
# normally forces it: each batch of trees only corrects the residuals of the window
# it saw, so 30 increments in a row drag the model towards the last few days, and
# the full one re-anchors it on the whole year. 0 disables the rule.
FULL_RETRAIN_AFTER_DAYS=30
# How stale the FRESHEST bin may be before the target goes RED. Splits the two reasons
# for "no new data": the cron ran twice within the hour (fine) from ingestion having
# died days ago - which without this stayed green for ever, because the full retrain
# over the same stale rows also succeeds. 0 disables it.
MAX_DATA_STALENESS_DAYS=3
# Tree cap, only a SAFETY NET now - it has to stay ABOVE the rule above (30 days x
# 50 trees = 1500) or it would always fire first. It bites if the job runs more
# often than daily, or if the increment grows.
MAX_ESTIMATORS=2000
# Widens the READING window of the warm start: (28 of lookback + these) days. It is
# NOT the number of days of rows trained on - the warm start trains with every usable
# row of that window minus the last day, which with ROLLING_MIN_COVERAGE=0.75 is ~9-10
# days, not 2. Raise it if the CronJob has been down for days. The 28 cannot be
# lowered: rolling_28d would go NaN and force a full retrain.
INCREMENTAL_TRAIN_DAYS=2
# Metric watchdog: the last day is measured with the old model and with the new
# one, and a MAE worse than this factor discards the increment and retrains fully.
INCREMENTAL_MAE_TOLERANCE=1.10
# Manual escape hatch: ignores whatever is in storage.
FORCE_FULL_RETRAIN=false

# --- Prediction (scripts/predict.py) ---
# Same live, per-zone source as training - the difference is the window: here it
# is the INCREMENTAL one, not the whole year.
MODEL_INPUT_PATH=crowd_xgboost_model.json
# Recursive prediction, tested end to end up to 168h with no drops. No hard 24h cap
# any more; reliability decreases the further it gets from real data (horizonStep).
PREDICTION_HORIZON_HOURS=24
# Testing/backtesting only. Empty = right after the last real data point
# (etl/predict/transform.py::_default_start_ts).
PREDICTION_START=
# PROVISIONAL: there is no official datamodel for crowd predictions in the platform yet.
# Renaming it renames the entities already created.
PREDICTION_ENTITY_TYPE=CrowdFlowPrediction
# A subfolder per target (<tenant>_<scope>) is created inside: the uploader
# publishes EVERY CSV of the folder, so sharing it would republish one tenant's
# predictions under the next one.
PREDICTIONS_FORECAST_OUTPUT_DIR=predictions_forecast

# --- Fake data (scripts/post_measures.py, NOT the ETL) ---
# Only for "--route iota" (direct POST to the IoT Agent), the TESTING path: it drops
# data under load, so use "--route batch" (CSV -> storage -> queue) for a long
# series. No default. PRE: https://k8s-pre-iota-json.the platformiot.work/iot/json
IOTA_URL=
IOTA_LIDAR_APIKEY=
IOTA_SMARTSPOT_APIKEY=
# Stable on purpose: re-running updates the same entities instead of piling up
# junk. CAREFUL: changing them creates NEW ones and orphans the previous.
TEST_ENTITY_PREFIX=crowd_test_obj_
TEST_SMARTSPOT_PREFIX=crowd_smartspot_test_

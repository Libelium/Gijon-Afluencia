# Configuration for deploy/docker-compose.core.yml.
# Copy to deploy/.env and fill in every credential:
#
#   cp deploy/.env.example deploy/.env
#
# There are NO default passwords. Compose refuses to start while any of them is
# empty, so a stack can never come up on a value that is public in this repo.
# Generate each one with:
#
#   openssl rand -hex 24
#
# These are unhardened development datastores. Everything below is published on
# BIND_ADDR, which defaults to the loopback address: they are reachable from the
# host and from nowhere else. Change it only if you know the host is not reachable
# from anywhere you do not control.
BIND_ADDR=127.0.0.1

# --- FIWARE ---
ORION_PORT=1026
IOTA_NORTH_PORT=4041
IOTA_SOUTH_PORT=7896
MONGO_PORT=27017
DEFAULT_TENANT=pidgijon
NGSI_LD_CONTEXT=https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context.jsonld

# Mongo runs with --auth: it holds every entity of the context broker and every
# device registration of the IoT Agent. Orion-LD and the IoT Agent use the same
# credentials against the `admin` database.
MONGO_USER=platform
MONGO_PASSWORD=

# --- Platform database ---
DB_PORT=5432
DB_DATABASE=platformdb
DB_USERNAME=platform
DB_PASSWORD=

# --- Timeseries ---
# 5433 on the host so it does not collide with the platform database.
TS_DB_PORT=5433
TS_DB_DATABASE=platformdb_ts
TS_DB_USERNAME=platform
TS_DB_PASSWORD=

# --- Broker ---
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=

# --- Object storage ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO root credentials. LOCAL_ACCESS_ID must be at least 3 characters and
# LOCAL_SECRET_KEY at least 8; the old minioadmin/minioadmin pair is not a default
# any more.
LOCAL_ACCESS_ID=
LOCAL_SECRET_KEY=

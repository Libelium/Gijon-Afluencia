# Configuración local resuelta a partir de los .env.example
.env
.env-*
!.env.example
!*.env.example

# Dependencias y artefactos de construcción
node_modules/
vendor/
dist/
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Entornos generados por el despliegue (contienen credenciales)
deploy/**/environments/*/
!deploy/**/environments/example/

# Registros y cachés de ejecución
*.log
.phpunit.result.cache
# Volcados del navegador de pruebas: llevan las URL del despliegue.
.playwright-mcp/

# Editor y sistema operativo
.idea/
.vscode/
.DS_Store

# Carpetas de trabajo de la raiz del repositorio.
#
# La barra inicial NO es opcional: un patron como `customization/` coincide a CUALQUIER
# profundidad, asi que tambien ignoraba frontend/src/customization/ y
# frontend/src/features/customization/ — codigo fuente del modulo de personalizacion, que
# desaparecia de `git status` sin avisar. Anclado a la raiz solo tapa lo que se pretendia.
/auditoria/
/fake_data/
/customization/

# API REST de la plataforma de datos
VITE_API_BASE_URL=https://api.example.org

# Proveedor de identidad OIDC (Keycloak)
VITE_OIDC_URL=https://auth.example.org
VITE_OIDC_REALM=nombre-del-realm
VITE_OIDC_CLIENT_ID=identificador-del-cliente

# Cartografia. Por defecto OpenStreetMap: no requiere ninguna clave.
# La atribucion es obligatoria por los terminos de uso de OSM.
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILES_ATTRIBUTION=&copy; colaboradores de OpenStreetMap
VITE_MAP_DEFAULT_CENTER=43.5322,-5.6611
VITE_MAP_DEFAULT_ZOOM=13

# Servidor de datos en vivo (opcional). La credencial NO va aqui:
# se solicita a la API en tiempo de ejecucion una vez hay sesion.
VITE_REALTIME_URL=

# Identificadores tecnicos que espera el backend. No son nombres de marca:
# son claves de datos existentes y deben coincidir con las del despliegue.
# Se dejan sin valor por defecto a proposito.
VITE_DATA_SCOPE_PREFERENCE_KEY=
VITE_ALARM_ENTITY_TYPE=

# URI de retorno del proveedor de identidad. Opcional: por defecto es <origen>/login.
# Debe estar dada de alta en el cliente OIDC.
VITE_OIDC_REDIRECT_URI=

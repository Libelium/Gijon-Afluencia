{
  "name": "pid-gijon",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "EUPL-1.2",
  "author": "Ayuntamiento de Gijón",
  "description": "Visualizador de datos de sensores urbanos: business intelligence y dashboards de analisis de datos.",
  "scripts": {
    "dev": "vite --port 20600 --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 20600",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "licenses": "npx --yes license-checker-rseidelsohn --production --json --out THIRD-PARTY-LICENSES.json"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "axios": "^1.7.9",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "keycloak-js": "^26.0.7",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "luxon": "^3.5.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.2.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.15",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/luxon": "^3.4.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.5",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}

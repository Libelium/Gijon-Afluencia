# ---------------------------------------------------------------------------
# Test environment for `php artisan test` / `vendor/bin/phpunit`.
#
# Laravel loads this file automatically because phpunit.xml sets APP_ENV=testing.
# It is committed on purpose: it contains no secrets, only throwaway local values,
# and the suite is not reproducible without it (GDTIS-PT01-FUN-018).
#
# ---------------------------------------------------------------------------
# WHY POSTGRESQL AND NOT SQLITE
# ---------------------------------------------------------------------------
# phpunit.xml used to carry a commented-out sqlite/:memory: block. It could never
# have worked, and it was removed rather than enabled:
#
#   * database/migrations/2023_08_31_085117_create_entities_table.php runs
#     `CREATE EXTENSION IF NOT EXISTS postgis;` and creates geometry columns.
#   * The schema is split over THREE connections that config/database.php declares
#     separately (pgsql, pgsql_realtime, device_manager); migration.sh migrates a
#     different directory into each. SQLite has no equivalent of that layout.
#   * Application code depends on PostgreSQL-only behaviour (jsonb operators,
#     ILIKE, `::` casts).
#
# ---------------------------------------------------------------------------
# MINIMUM ENVIRONMENT (one container)
# ---------------------------------------------------------------------------
#   docker run -d --name pid-test-pg \
#     -e POSTGRES_USER=pid -e POSTGRES_PASSWORD=pidtest \
#     -e POSTGRES_DB=pid_gijon_test \
#     -p 5432:5432 postgis/postgis:15-3.4-alpine
#
#   docker exec pid-test-pg psql -U pid -d postgres \
#     -c 'CREATE DATABASE device_manager;' -c 'CREATE DATABASE realtime;'
#
# Then build the schema the same way production does, with the repository's own
# bootstrap script. It migrates the three paths in the right order and runs the
# seeders the tests depend on (device types, permissions, preferences):
#
#   php artisan migrate --database=device_manager --path=database/migrations/device_manager --force
#   php artisan migrate --database=pgsql_realtime  --path=database/migrations/realtime      --force
#   php artisan migrate --database=pgsql           --path=database/migrations               --force
#   php artisan db:seed --class=DeviceTypesSeeder
#   php artisan db:seed --class=SyncSeeder
#
# (./migration.sh runs exactly that, plus the Keycloak sync step, which the tests
# do not need and which requires a reachable Keycloak.)
#
# After that: php artisan test
#
# Tests use DatabaseTransactions, so each test rolls back and the schema only has
# to be created once.
# ---------------------------------------------------------------------------

APP_NAME="PID Gijon - API (testing)"
APP_ENV=testing
# Throwaway key. The suite never touches production data, but Laravel refuses to
# boot the encrypter without one.
APP_KEY=base64:MFDd5kNkK3ZKror/m+PYSuNCKQh2bnpBhfHU3Vj/dYE=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_QUERIES=0

# --- PostgreSQL (PostGIS required) ---
# NOTE: config/database.php defaults DB_CONNECTION to 'psql', which is NOT a
# connection defined in that file. Leaving it unset makes every database-backed
# test fail with "Database connection [psql] not configured."
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pid_gijon_test
DB_USERNAME=pid
DB_PASSWORD=pidtest
DB_DEVICE_MANAGER_DATABASE=device_manager

DB_REALTIME_HOST=127.0.0.1
DB_REALTIME_PORT=5432
DB_REALTIME_DATABASE=realtime
DB_REALTIME_USERNAME=pid
DB_REALTIME_PASSWORD=pidtest

# --- Drivers: nothing external. No Redis, no Elasticsearch, no SMTP. ---
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
MAIL_MAILER=array
SCOUT_DRIVER=null
TELESCOPE_ENABLED=false

# --- aether-link (context broker gateway): never contacted by the suite, which fakes
#     the HTTP layer, but config/services.php interpolates this into the endpoint URLs
#     so it must be a syntactically valid base URL. ---
AETHER_LINK_URL=http://aether-link.invalid

# --- Keycloak: never contacted by the suite; the guard only needs the values to
#     exist so the application can boot. ---
KEYCLOAK_URL=http://keycloak.invalid
KEYCLOAK_REALM=pid-gijon
KEYCLOAK_CLIENT_ID=pid-api
KEYCLOAK_CLIENT_SECRET=testing
KEYCLOAK_PUBLIC_KEY=
KEYCLOAK_ENCRYPTION_ALGORITHM=RS256
KEYCLOAK_REDIRECT_URI=http://keycloak.invalid
KEYCLOAK_FRONTEND_CLIENT_ID=pid-gijon-client

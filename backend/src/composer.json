{
    "name": "pid-gijon/backend",
    "type": "project",
    "description": "PID Gijón — management and read API",
    "keywords": [
        "laravel",
        "api",
        "iot"
    ],
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Libelium Comunicaciones Distribuidas, S.L.",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "babenkoivan/elastic-scout-driver-plus": "^4.6",
        "fakerphp/faker": "^1.9.1",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.50.3",
        "laravel/sanctum": "^3.3",
        "laravel/scout": "^10.6",
        "laravel/tinker": "^2.8",
        "league/csv": "^9.19",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mews/purifier": "^3.4",
        "owen-it/laravel-auditing": "^13.7",
        "robsontenorio/laravel-keycloak-guard": "^1.6",
        "spatie/laravel-permission": "^6.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "jeroen-g/laravel-packager": "^2.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-mdq4-51ck-6kdq": "CVE-2026-48019 / GHSA-5vg9-5847-vvmq - CRLF injection in the default 'email' validation rule. Affects EVERY Laravel 9/10/11 release and is only fixed in >=12.60.0: there is NO fix inside the 10.x series, so it cannot be resolved by pinning. Accepted here only to keep the resolver able to install a TAGGED 10.x release instead of the moving 10.x-dev branch (GDTIS-PT01-COD-099). Real remediation = upgrade to Laravel 12.61.1+; tracked separately.",
                    "PKSA-3r5d-mb8f-1qw9": "GHSA-5vg9-5847-vvmq (GitHub-sourced duplicate of PKSA-mdq4-51ck-6kdq, same CRLF injection in the default email rule). Fixed only in >=12.60.0. Same rationale as above.",
                    "PKSA-m5cs-t1y6-qpcs": "GHSA-crmm-hgp2-wgrp - Temporary Signed URL path confusion. Fixed only in >=12.61.1; no 10.x backport exists. Same rationale as above."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

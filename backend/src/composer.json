{
    "name": "pid-gijon/backend",
    "type": "project",
    "description": "PID Gijón — management and read API",
    "keywords": [
        "laravel",
        "api",
        "iot"
    ],
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Libelium Comunicaciones Distribuidas, S.L.",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "babenkoivan/elastic-scout-driver-plus": "^4.6",
        "fakerphp/faker": "^1.9.1",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/scout": "^10.6",
        "laravel/tinker": "^2.8",
        "league/csv": "^9.19",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mews/purifier": "^3.4",
        "owen-it/laravel-auditing": "^13.7",
        "robsontenorio/laravel-keycloak-guard": "^1.6",
        "spatie/laravel-permission": "^6.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "jeroen-g/laravel-packager": "^2.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

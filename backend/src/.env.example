# ---------------------------------------------------------------------------
# PID Gijón — backend API. Copy to .env and fill in.
#   cp .env.example .env && php artisan key:generate
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="PID Gijon - API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:20600
CORS_ALLOWED_ORIGINS=http://localhost:20600

# --- Logging ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_QUERIES=0

# --- PostgreSQL (PostGIS required: some migrations create geometry columns) ---
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=pid_gijon
DB_USERNAME=pid
DB_PASSWORD=
# Device-manager schema, same server as DB_HOST/DB_USERNAME above
DB_DEVICE_MANAGER_DATABASE=device_manager

# --- Realtime database (CDC table feeding the WebSocket channel) ---
DB_REALTIME_HOST=host.docker.internal
DB_REALTIME_PORT=5432
DB_REALTIME_DATABASE=realtime
DB_REALTIME_USERNAME=pid
DB_REALTIME_PASSWORD=

# --- Drivers (defaults chosen so no Redis / Elasticsearch is needed) ---
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
SCOUT_DRIVER=null

# --- Keycloak (authentication) ---
KEYCLOAK_URL=https://keycloak.pid.gijon.example
KEYCLOAK_REALM=pid-gijon
KEYCLOAK_CLIENT_ID=pid-api
KEYCLOAK_CLIENT_SECRET=
# PEM body of the realm's RS256 public key, single line, no BEGIN/END markers
KEYCLOAK_PUBLIC_KEY=
KEYCLOAK_ENCRYPTION_ALGORITHM=RS256
KEYCLOAK_REDIRECT_URI=https://keycloak.pid.gijon.example
# Public client the password-reset e-mail redirects through
KEYCLOAK_FRONTEND_CLIENT_ID=pid-gijon-client

# Keycloak admin API (user provisioning)
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=
KC_ADMIN_CLIENT=admin-cli
KC_MASTER_REALM=master

# Keycloak impersonation (support login-as)
KC_IMPERSONATION_URL=https://keycloak.pid.gijon.example
KC_IMPERSONATION_REALM=pid
KC_IMPERSONATION_CLIENT_ID=pid-gijon-client
KC_IMPERSONATION_CLIENT_SECRET=
KC_IMPERSONATION_USERNAME=
KC_IMPERSONATION_PASSWORD=

# --- Platform peers ---
AETHER_LINK_URL=https://aether-link.pid.gijon.example
QUEUES_CONSUMER_API_URL=https://queues-consumer.pid.gijon.example
COMMANDS_ENDPOINT=https://fiware-manager.pid.gijon.example/api/v1
DATA_REPORT=https://fiware-manager.pid.gijon.example
DATA_REPORT_EXTERNAL=https://fiware-manager.pid.gijon.example
DEVICE_MANAGER_URL=https://device-manager.pid.gijon.example
CHATBOT_API_URL=http://chatbot:8000
CHATBOT_TIMEOUT=300

# --- Object storage (S3-compatible; leave empty to stay on the local disk) ---
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_KEY=
AWS_S3_SECRET=
AWS_S3_IMAGES_REGION=
AWS_S3_IMAGES_BUCKET=
AWS_S3_IMAGES_KEY=
AWS_S3_IMAGES_SECRET=

# --- Mail ---
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@pid.gijon.example
MAIL_FROM_NAME="PID Gijon"

# --- Encryption / signing keys (leave blank so they are generated on install) ---
FILE_ENCRYPTION_KEY=
GENERIC_ENCRYPTION_KEY=
PSEUDONYMIZATION_KEY=
ENCRYPTION_ENTITIES_KEY=
MQTT_ENCRYPTION_KEY=

# MQTT broker administrator, seeded by MqttUserSeeder. Leave blank to skip it.
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD_HASH=
MQTT_ADMIN_PASSWORD_ENCRYPTED=
MQTT_ADMIN_PASSWORD_SALT=
API_GATEWAY_SECRET=

# --- Notifications & integrations (all optional) ---
SMS_ENABLED=false
SMS_FROM=
SMS_AWS_REGION=
SMS_AWS_KEY=
SMS_AWS_SECRET=
TELEGRAM_ENABLED=false
TELEGRAM_CLIENT_ID=
WHATSAPP_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_KEY=

# --- Deployment shape ---
ON_PREMISE=false
AUDITING_ENABLED=true

# --- Incident module ---
PUBLIC_INCIDENTS_WORKSPACE="Public Incidents"
REVIEWERS_INCIDENTS_WORKSPACE="Reviewers Incidents"
OPERATOR_ROLE=PID-INCIDENT-OPERATOR
GUEST_EXTRA_PERMISSIONS=INCIDENTS_READ,DATA_SOURCES_ENTITIES_UPLOAD_DATA,DATA_SOURCES_ENTITIES_UPDATE
SELF_PROVISIONING_ROLE=
SELF_PROVISIONING_CLIENTS="[\"pid-gijon-mobile\",\"pid-gijon-client\"]"
SELF_PROVISIONING_ORGANIZATION="{\"Incident\":1}"

